{
  "name": "@agent-orchestrator/claude-led-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone, provider-neutral MVP contracts and orchestration primitives.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  }
}
